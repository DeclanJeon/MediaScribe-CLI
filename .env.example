# MediaScribe-CLI environment template.
#
# This file is NOT loaded automatically. Choose one explicit source:
#   1. mediascribe transcribe ... --env-file /path/to/this-file
#   2. export MEDIASCRIBE_ENV_FILE=/path/to/this-file
#   3. cp this-file ~/.config/mediascribe/env   (user-level config)
# Working-directory .env/.env.local files are intentionally ignored so a
# hostile directory cannot redirect API keys or transcripts.
# Keep any file containing keys private: chmod 600 <file>.

# OpenRouter is tried first for AI body summaries.
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"
OPENROUTER_MODEL="deepseek/deepseek-v4-flash-0731:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
# Optional attribution headers:
# OPENROUTER_HTTP_REFERER="https://your-app.example"
# OPENROUTER_APP_TITLE="MediaScribe-CLI"

# OpenCode Go is used when OpenRouter is unavailable or fails.
OPENCODE_API_KEY="YOUR_OPENCODE_API_KEY"
OPENCODE_MODEL="deepseek-v4-flash"
OPENCODE_API_BASE_URL="https://opencode.ai/zen/go/v1"

# Provider endpoints must be https on allowlisted hosts (openrouter.ai /
# opencode.ai). http is allowed only for loopback dev gateways. To opt in to
# a different https endpoint:
# MEDIASCRIBE_ALLOW_CUSTOM_ENDPOINT="1"   # or pass --allow-custom-endpoint

# Transcription defaults.
MEDIASCRIBE_OUTPUT_FORMAT="md"
MEDIASCRIBE_MODEL="small"
MEDIASCRIBE_LANGUAGE=""

# Speaker diarization. HF_TOKEN is read from the environment only — there is
# no CLI flag, so the token never appears in argv or logs.
HF_TOKEN="YOUR_HUGGINGFACE_TOKEN"

# Resume / checkpoints (state lives in <output-dir>/.mediascribe/).
# MEDIASCRIBE_RESUME="0"                  # same as --no-resume
# MEDIASCRIBE_FOLLOW_SYMLINKS="1"         # same as --follow-symlinks

# Long transcripts are summarized in bounded chunks (map-reduce).
# MEDIASCRIBE_SUMMARY_CHUNK_CHARS="24000" # same as --summary-chunk-chars

# JSONL events replace transcript text with a sha256 digest by default.
# MEDIASCRIBE_EVENTS_FULL_TEXT="1"       # opt out: same as --events-full-text
